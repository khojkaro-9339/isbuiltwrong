---
import type { Locale } from '../i18n/translations';
import { getTranslations } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getTranslations(locale);
---
<section class="py-16 sm:py-24 bg-[var(--color-surface-raised)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="font-[family-name:var(--font-heading)] text-2xl sm:text-3xl font-bold mb-4">
        {t.cta.title}
      </h2>
      <p class="text-[var(--color-text-secondary)] text-lg leading-relaxed mb-8">
        {t.cta.desc}
      </p>
      <a href="https://khojkaro.in" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 bg-[var(--color-brand)] text-white font-semibold px-8 py-4 rounded-xl hover:bg-[var(--color-brand-dark)] transition-all hover:scale-[1.02] active:scale-[0.98]">
        {t.cta.button}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>
  </div>
</section>
