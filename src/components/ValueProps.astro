---
import type { Locale } from '../i18n/translations';
import { getTranslations } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getTranslations(locale);

const icons = [
  '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>',
  '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>',
  '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 4V2m0 2a2 2 0 100 4m0-4a2 2 0 110 4m0 0v14m10-4V2m0 2a2 2 0 100 4m0-4a2 2 0 110 4m0 0v6"/></svg>',
  '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
];
---
<section class="py-16 sm:py-24 border-t border-[var(--color-border)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <h2 class="font-[family-name:var(--font-heading)] text-2xl sm:text-3xl font-bold mb-12 sm:mb-16">
      {t.value.title}
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8">
      {t.value.items.map((item, i) => (
        <div class="group bg-[var(--color-surface-raised)] border border-[var(--color-border)] rounded-2xl p-6 sm:p-8 hover:border-[var(--color-brand)]/30 transition-all duration-300">
          <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-[var(--color-brand)]/10 text-[var(--color-brand)] mb-5">
            <Fragment set:html={icons[i]} />
          </div>
          <h3 class="font-[family-name:var(--font-heading)] text-lg font-semibold mb-3 group-hover:text-[var(--color-brand)] transition-colors">
            {item.title}
          </h3>
          <p class="text-[var(--color-text-secondary)] leading-relaxed">
            {item.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
