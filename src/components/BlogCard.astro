---
interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tags?: string[];
  readMore?: string;
}

const { title, description, date, slug, tags = [], readMore = 'Read more' } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---
<article class="group bg-[var(--color-surface-raised)] border border-[var(--color-border)] rounded-2xl p-6 sm:p-8 hover:border-[var(--color-brand)]/30 transition-all duration-300">
  <div class="flex items-center gap-3 mb-4">
    <time datetime={date.toISOString()} class="text-sm text-[var(--color-text-muted)]">
      {formattedDate}
    </time>
    {tags.length > 0 && (
      <span class="text-[var(--color-text-muted)]">&middot;</span>
      <span class="text-xs font-medium text-[var(--color-brand)] bg-[var(--color-brand)]/10 px-2 py-0.5 rounded-full">{tags[0]}</span>
    )}
  </div>

  <h3 class="font-[family-name:var(--font-heading)] text-xl font-semibold mb-3 group-hover:text-[var(--color-brand)] transition-colors">
    <a href={`/blog/${slug}`} class="block">
      {title}
    </a>
  </h3>

  <p class="text-[var(--color-text-secondary)] leading-relaxed mb-4 line-clamp-3">
    {description}
  </p>

  <a href={`/blog/${slug}`} class="inline-flex items-center gap-1.5 text-sm font-medium text-[var(--color-brand)] hover:gap-2.5 transition-all">
    {readMore}
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
  </a>
</article>
