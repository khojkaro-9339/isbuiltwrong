---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n/translations';

const locale = 'bn';
const t = getTranslations(locale);

const categories = [
  { value: 'plumber', label: 'প্লাম্বার' },
  { value: 'electrician', label: 'ইলেকট্রিশিয়ান' },
  { value: 'restaurant', label: 'রেস্টুরেন্ট / ফুড' },
  { value: 'salon', label: 'সেলুন / বিউটি' },
  { value: 'doctor', label: 'ডাক্তার / ক্লিনিক' },
  { value: 'retail_shop', label: 'রিটেল শপ' },
  { value: 'gym_fitness', label: 'জিম / ফিটনেস' },
  { value: 'tuition_coaching', label: 'টিউশন / কোচিং' },
  { value: 'real_estate', label: 'রিয়েল এস্টেট' },
  { value: 'hotel_lodge', label: 'হোটেল / লজ' },
  { value: 'ca_accountant', label: 'CA / অ্যাকাউন্ট্যান্ট' },
  { value: 'tailor', label: 'টেলার / ফ্যাশন' },
  { value: 'other', label: 'অন্যান্য' },
];
---
<BaseLayout title={`${t.audit.title} | Is Built Wrong`} description={t.audit.subtitle} locale={locale}>
  <section class="py-16 sm:py-24">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-red-50 border border-red-200 text-red-700 text-xs font-medium mb-6">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
          ১০০% বিনামূল্যে
        </div>
        <h1 class="font-[family-name:var(--font-heading)] text-3xl sm:text-4xl font-bold mb-4">{t.audit.title}</h1>
        <p class="text-lg text-[var(--color-text-secondary)]">{t.audit.subtitle}</p>
      </div>

      <form id="audit-form" class="space-y-6 bg-white border border-[var(--color-border)] rounded-2xl p-6 sm:p-8 shadow-sm">
        <div>
          <label for="url" class="block text-sm font-medium mb-2">{t.audit.formUrl}</label>
          <input type="text" id="url" name="url" required placeholder={t.audit.formUrlPlaceholder} class="w-full px-4 py-3 rounded-lg border border-[var(--color-border)] focus:ring-2 focus:ring-[var(--color-brand)] focus:border-transparent outline-none transition-all" />
        </div>
        <div>
          <label for="business_name" class="block text-sm font-medium mb-2">{t.audit.formName}</label>
          <input type="text" id="business_name" name="business_name" required placeholder={t.audit.formNamePlaceholder} class="w-full px-4 py-3 rounded-lg border border-[var(--color-border)] focus:ring-2 focus:ring-[var(--color-brand)] focus:border-transparent outline-none transition-all" />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="city" class="block text-sm font-medium mb-2">{t.audit.formCity}</label>
            <input type="text" id="city" name="city" placeholder={t.audit.formCityPlaceholder} class="w-full px-4 py-3 rounded-lg border border-[var(--color-border)] focus:ring-2 focus:ring-[var(--color-brand)] focus:border-transparent outline-none transition-all" />
          </div>
          <div>
            <label for="category" class="block text-sm font-medium mb-2">{t.audit.formCategory}</label>
            <select id="category" name="category" class="w-full px-4 py-3 rounded-lg border border-[var(--color-border)] focus:ring-2 focus:ring-[var(--color-brand)] focus:border-transparent outline-none transition-all bg-white">
              <option value="">{t.audit.formCategorySelect}</option>
              {categories.map(cat => <option value={cat.value}>{cat.label}</option>)}
            </select>
          </div>
        </div>
        <button type="submit" id="submit-btn" class="w-full py-4 px-6 bg-[var(--color-brand)] text-white font-semibold rounded-lg hover:bg-[var(--color-brand-dark)] transition-colors text-lg">{t.audit.formSubmit}</button>
        <p id="loading-text" class="hidden text-center text-[var(--color-text-secondary)] animate-pulse">{t.audit.formLoading}</p>
      </form>

      <div id="results-container" class="hidden mt-8"></div>
    </div>
  </section>

  <script define:vars={{ locale }}>
    const form = document.getElementById('audit-form');
    const submitBtn = document.getElementById('submit-btn');
    const loadingText = document.getElementById('loading-text');
    const resultsContainer = document.getElementById('results-container');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
      loadingText.classList.remove('hidden');
      resultsContainer.classList.add('hidden');

      const formData = new FormData(form);
      const payload = {
        url: formData.get('url'),
        business_name: formData.get('business_name'),
        city: formData.get('city') || undefined,
        category: formData.get('category') || undefined,
        locale: locale,
      };

      try {
        const response = await fetch('https://ibw-audit-api.9xsz65f782.workers.dev', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Audit failed');
        showResults(data, payload);
      } catch (err) {
        resultsContainer.innerHTML = `<div class="p-6 bg-red-50 border border-red-200 rounded-xl text-red-700">${err.message}</div>`;
        resultsContainer.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        loadingText.classList.add('hidden');
      }
    });

    function showResults(data, payload) {
      const scoreColor = data.overall_score < 40 ? 'text-red-600' : data.overall_score < 70 ? 'text-amber-600' : 'text-green-600';
      const scoreBg = data.overall_score < 40 ? 'bg-red-50 border-red-200' : data.overall_score < 70 ? 'bg-amber-50 border-amber-200' : 'bg-green-50 border-green-200';
      const invisiblePercent = Math.max(50, 100 - data.overall_score);

      const issuesHtml = data.preview_issues.map((issue, i) =>
        `<li class="flex items-start gap-3 py-2"><span class="flex-shrink-0 w-6 h-6 rounded-full bg-red-100 text-red-600 flex items-center justify-center text-xs font-bold">${i + 1}</span><span>${issue.text}</span></li>`
      ).join('');

      const remainingIssues = data.total_issues - data.preview_issues.length;
      const whatsappText = encodeURIComponent(`Hi! My isbuiltwrong audit:\n\nBusiness: ${payload.business_name}\nScore: ${data.overall_score}/100\nReport: https://isbuiltwrong.com/report/${data.id}\n\nPlease review and advise!`);

      resultsContainer.innerHTML = `
        <div class="space-y-6">
          <div class="${scoreBg} border rounded-2xl p-8 text-center">
            <p class="text-sm font-medium text-gray-600 mb-2">স্কোর</p>
            <p class="${scoreColor} text-6xl sm:text-7xl font-bold font-[family-name:var(--font-heading)] animate-pulse">${data.overall_score}<span class="text-2xl">/100</span></p>
          </div>
          <div class="bg-gray-900 text-white rounded-2xl p-6 space-y-4">
            <p class="text-lg font-medium">${payload.city || 'আপনার শহরে'} ${payload.category || 'ব্যবসা'} খুঁজছেন এমন <span class="text-red-400 font-bold">${invisiblePercent}%</span> মানুষের কাছে আপনার ব্যবসা <span class="text-red-400 font-bold">INVISIBLE</span></p>
            <p class="text-gray-300">আপনার এলাকার সেরা ব্যবসাগুলো <span class="text-green-400 font-bold">82+</span> স্কোর করে। তারা আপনার customer নিয়ে নিচ্ছে।</p>
            <p class="text-amber-400 font-semibold">আপনি প্রতি মাসে আনুমানিক ₹15,000-45,000 হারাচ্ছেন।</p>
          </div>
          <div class="bg-white border border-[var(--color-border)] rounded-2xl p-6">
            <h3 class="font-bold text-lg mb-4 text-red-600">${data.preview_issues.length}টি গুরুতর সমস্যা পাওয়া গেছে:</h3>
            <ul class="space-y-1">${issuesHtml}</ul>
            ${remainingIssues > 0 ? `<p class="mt-4 text-sm text-gray-500 font-medium">আরও ${remainingIssues}টি সমস্যা পাওয়া গেছে। সব দেখুন + প্রতিটি কীভাবে ঠিক করবেন।</p>` : ''}
          </div>
          <a href="https://wa.me/918101654027?text=${whatsappText}" target="_blank" rel="noopener" class="flex items-center justify-center gap-3 w-full py-4 px-6 bg-[#25D366] text-white font-bold rounded-xl text-lg hover:bg-[#1fb855] transition-colors shadow-lg">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp-এ পুরো রিপোর্ট পান
          </a>
        </div>`;
      resultsContainer.classList.remove('hidden');
      resultsContainer.scrollIntoView({ behavior: 'smooth' });
    }
  </script>
</BaseLayout>
