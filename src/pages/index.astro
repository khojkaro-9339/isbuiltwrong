---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
  <title>Is Built Wrong — Choose Your Language</title>
  <meta name="description" content="Your business is built wrong. We'll show you why — in your language." />
  <script>
    const saved = localStorage.getItem('ibw_lang');
    if (saved) {
      window.location.replace('/in/' + saved + '/');
    }
  </script>
</head>
<body class="min-h-screen flex items-center justify-center px-4">
  <div class="max-w-lg w-full text-center">
    <img src="/images/logo.webp" alt="Is Built Wrong" class="h-12 sm:h-14 mx-auto mb-8" />
    
    <h1 class="font-[family-name:var(--font-heading)] text-2xl sm:text-3xl font-bold mb-3">
      अपनी भाषा चुनें
    </h1>
    <p class="text-[var(--color-text-secondary)] mb-10 text-lg">
      Pick your language
    </p>

    <div class="grid grid-cols-2 gap-4">
      <a href="/in/hi/" onclick="localStorage.setItem('ibw_lang','hi')" class="group flex flex-col items-center gap-2 bg-[var(--color-surface-raised)] border border-[var(--color-border)] rounded-2xl p-6 hover:border-[var(--color-brand)]/50 hover:bg-[var(--color-surface-overlay)] transition-all">
        <span class="text-2xl font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-brand)] transition-colors">हिंदी</span>
        <span class="text-sm text-[var(--color-text-muted)]">हिंदी में पढ़ें</span>
      </a>

      <a href="/in/en/" onclick="localStorage.setItem('ibw_lang','en')" class="group flex flex-col items-center gap-2 bg-[var(--color-surface-raised)] border border-[var(--color-border)] rounded-2xl p-6 hover:border-[var(--color-brand)]/50 hover:bg-[var(--color-surface-overlay)] transition-all">
        <span class="text-2xl font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-brand)] transition-colors">English</span>
        <span class="text-sm text-[var(--color-text-muted)]">Read in English</span>
      </a>

      <a href="/in/bn/" onclick="localStorage.setItem('ibw_lang','bn')" class="group flex flex-col items-center gap-2 bg-[var(--color-surface-raised)] border border-[var(--color-border)] rounded-2xl p-6 hover:border-[var(--color-brand)]/50 hover:bg-[var(--color-surface-overlay)] transition-all">
        <span class="text-2xl font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-brand)] transition-colors">বাংলা</span>
        <span class="text-sm text-[var(--color-text-muted)]">বাংলায় পড়ুন</span>
      </a>

      <a href="/in/ne/" onclick="localStorage.setItem('ibw_lang','ne')" class="group flex flex-col items-center gap-2 bg-[var(--color-surface-raised)] border border-[var(--color-border)] rounded-2xl p-6 hover:border-[var(--color-brand)]/50 hover:bg-[var(--color-surface-overlay)] transition-all">
        <span class="text-2xl font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-brand)] transition-colors">नेपाली</span>
        <span class="text-sm text-[var(--color-text-muted)]">नेपालीमा पढ्नुहोस्</span>
      </a>
    </div>

    <p class="mt-8 text-xs text-[var(--color-text-muted)]">
      आप बाद में भी भाषा बदल सकते हैं &middot; আপনি পরেও ভাষা পাল্টাতে পারবেন &middot; तपाईँले पछि पनि भाषा परिवर्तन गर्न सक्नुहुन्छ
    </p>
  </div>
</body>
</html>
